+  if (path.ends_with(".index.json")) {
+    @autoreleasepool {
+      NSData* data = [NSData dataWithContentsOfFile:[NSString stringWithUTF8String:path.c_str()]];
+      if (!data) throw std::runtime_error("Could not open weight index: " + path);
+      NSDictionary* index = json_object(data);
+      NSMutableDictionary* specs = [NSMutableDictionary new];
+      const auto parent = std::filesystem::path(path).parent_path();
+      NSString* base = index[@"base"];
+      if (base != nil) {
+        auto source = std::make_unique<WeightStore>(parent / base.UTF8String);
+        for (NSString* key in source->specs_) {
+          specs[key] = source->specs_[key];
+          tensor_sources_[key.UTF8String] = source.get();
+        }
+        shards_.emplace("", std::move(source));
+      }
+      NSDictionary* mapping = index[@"weight_map"];
+      for (NSString* key in mapping) {
+        NSString* filename = mapping[key];
+        const std::string shard = filename.UTF8String;
+        auto& source = shards_[shard];
+        if (!source) source = std::make_unique<WeightStore>(parent / shard);
+        NSDictionary* spec = source->specs_[key];
+        if (!spec) throw std::runtime_error("Tensor missing from shard: " + std::string(key.UTF8String));
+        specs[key] = spec;
+        tensor_sources_[key.UTF8String] = source.get();
+      }
+      specs_ = specs;
+    }
+    return;
+  }
